<!doctype html>
<html lang="it">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Dorsale Spazio · L'economia spaziale europea</title>

  <style>
    :root {
      --bg: #02050d;
      --bg-deep: #01030a;
      --card: rgba(6, 12, 26, 0.92);
      --ink: #eef8ff;
      --muted: #9eb4c8;
      --line: rgba(88, 181, 255, 0.26);
      --line-strong: rgba(111, 210, 255, 0.58);
      --accent: #62d8ff;
      --accent-2: #8b7dff;
      --data: #78ffb3;
      --accent-soft: rgba(98, 216, 255, 0.10);
    }

    * { box-sizing: border-box; }

    html { scroll-behavior: smooth; }

    body {
      margin: 0;
      color: var(--ink);
      background:
        radial-gradient(circle at 50% -8%, rgba(90, 175, 255, 0.22), transparent 30%),
        radial-gradient(circle at 85% 12%, rgba(128, 92, 255, 0.12), transparent 24%),
        radial-gradient(circle at 15% 22%, rgba(70, 215, 255, 0.08), transparent 28%),
        linear-gradient(180deg, #030816 0%, #02050d 38%, #01030a 100%);
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      line-height: 1.55;
      min-height: 100vh;
      position: relative;
      overflow-x: hidden;
    }

    body::before {
      content: "";
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: -2;
      background-image:
        radial-gradient(circle, rgba(255,255,255,.82) 0 1px, transparent 1.2px),
        radial-gradient(circle, rgba(124,205,255,.52) 0 1px, transparent 1.2px),
        radial-gradient(circle, rgba(255,255,255,.36) 0 1px, transparent 1.2px);
      background-size: 173px 173px, 251px 251px, 337px 337px;
      background-position: 21px 37px, 111px 89px, 53px 191px;
      opacity: .30;
    }

    body::after {
      content: "";
      position: fixed;
      left: -10vw;
      right: -10vw;
      top: -34vw;
      height: 46vw;
      min-height: 330px;
      border-radius: 0 0 50% 50%;
      pointer-events: none;
      z-index: -1;
      border-bottom: 1px solid rgba(104, 207, 255, .26);
      box-shadow:
        0 14px 70px rgba(71, 168, 255, .18),
        0 28px 140px rgba(56, 104, 255, .10);
      background:
        radial-gradient(ellipse at center bottom,
          rgba(31, 104, 176, .18) 0%,
          rgba(12, 31, 66, .10) 42%,
          transparent 67%);
    }

    a { color: #9fe3ff; }

    code {
      color: #9fe3ff;
      background: rgba(98, 216, 255, 0.08);
      border: 1px solid rgba(98, 216, 255, 0.18);
      border-radius: 5px;
      padding: 0 0.25em;
    }

    .story {
      max-width: 960px;
      margin: 0 auto;
      padding: 22px;
    }

    .kicker {
      margin: 0 0 6px;
      color: var(--muted);
      font-size: 0.82rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    h1 {
      margin: 0 0 10px;
      font-size: clamp(1.9rem, 4vw, 3rem);
      line-height: 1.04;
      text-shadow: 0 0 12px rgba(98, 216, 255, 0.18);
    }

    h2 { margin-top: 0; }
    h3 { margin-bottom: 0.45rem; color: #deeffb; }

    .lead {
      margin: 0 0 18px;
      max-width: 78ch;
      color: #deeffb;
      font-size: 1.04rem;
    }

    .note {
      border-left: 4px solid var(--accent);
      background: var(--accent-soft);
      padding: 10px 12px;
      border-radius: 8px;
      margin: 16px 0 20px;
      color: #d4eaf7;
      font-size: 0.94rem;
    }

    .controls {
      position: sticky;
      top: 0;
      z-index: 3;
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      padding: 12px;
      margin: 0 -12px 18px;
      background: rgba(3, 8, 20, 0.88);
      border: 1px solid var(--line);
      border-radius: 14px;
      backdrop-filter: blur(8px);
      box-shadow: 0 0 22px rgba(98, 216, 255, 0.06);
    }

    .step-btn {
      appearance: none;
      border: 1px solid var(--line);
      border-radius: 999px;
      background: rgba(2, 7, 18, 0.68);
      color: var(--ink);
      padding: 8px 12px;
      font: inherit;
      font-size: 0.91rem;
      cursor: pointer;
      transition: transform 120ms ease, background 120ms ease, border-color 120ms ease, color 120ms ease;
    }

    .step-btn:hover {
      transform: translateY(-1px);
      border-color: var(--line-strong);
      background: rgba(98, 216, 255, 0.10);
    }

    .step-btn.is-active {
      background: var(--accent);
      color: #020814;
      border-color: var(--accent);
      font-weight: 750;
      box-shadow: 0 0 16px rgba(98, 216, 255, 0.22);
    }

    .current {
      color: var(--muted);
      font-size: 0.9rem;
      margin: -4px 0 16px;
    }

    .current-command {
      color: var(--ink);
      font-weight: 700;
    }

    .section {
      background: linear-gradient(180deg, rgba(8, 17, 36, 0.94), rgba(3, 8, 19, 0.96));
      border: 1px solid var(--line);
      border-radius: 18px;
      padding: 18px;
      margin: 0 0 16px;
      box-shadow: 0 12px 34px rgba(0, 0, 0, 0.50), inset 0 0 28px rgba(98, 216, 255, 0.025);
    }

    .storybox {
      border-color: var(--line-strong);
      background:
        linear-gradient(rgba(98, 216, 255, 0.035) 50%, rgba(0, 0, 0, 0.035) 50%),
        linear-gradient(180deg, rgba(9, 22, 45, 0.97), rgba(3, 8, 20, 0.98));
      background-size: 100% 4px, auto;
    }

    .story-kicker {
      margin: 0 0 6px;
      color: var(--accent);
      text-transform: uppercase;
      letter-spacing: 0.12em;
      font-size: 0.78rem;
      font-weight: 750;
    }

    .story-body {
      color: #e8f5ff;
      max-width: 82ch;
    }

    .facts {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin: 12px 0 0;
    }

    .chip {
      display: inline-flex;
      align-items: center;
      border: 1px solid rgba(98, 216, 255, 0.24);
      background: rgba(57, 255, 20, 0.07);
      border-radius: 999px;
      padding: 5px 9px;
      color: #deeffb;
      font-size: 0.82rem;
    }

    .chain {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 8px;
      margin: 14px 0 4px;
    }

    .chain div {
      text-align: center;
      border: 1px solid rgba(98, 216, 255, 0.18);
      border-radius: 9px;
      padding: 9px 6px;
      font-size: 0.76rem;
      color: #d4eaf7;
      background: rgba(98, 216, 255, 0.045);
    }

    .chain div::after {
      content: "→";
      float: right;
      color: var(--muted);
      margin-right: -11px;
    }

    .chain div:last-child::after { content: ""; }

    .metrics {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 10px;
      margin-top: 12px;
    }

    .metric {
      border: 1px solid var(--line);
      border-radius: 12px;
      padding: 12px;
      background: rgba(98, 216, 255, 0.04);
    }

    .metric strong {
      display: block;
      color: var(--accent);
      font-size: 1.15rem;
      margin-bottom: 3px;
    }

    .metric span {
      color: var(--muted);
      font-size: 0.82rem;
    }

    .crosslinks {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
      margin-top: 12px;
    }

    .crosslinks div {
      border: 1px solid var(--line);
      border-radius: 10px;
      padding: 10px;
      background: rgba(98, 216, 255, 0.035);
    }

    .future {
      opacity: 0.78;
      border-style: dashed;
    }

    .sources li { margin-bottom: 7px; }

    .foot {
      color: var(--muted);
      font-size: 0.88rem;
      margin-top: 18px;
    }


    .story {
      position: relative;
    }

    .story::before,
    .story::after {
      content: "";
      position: absolute;
      pointer-events: none;
      z-index: -1;
      border: 1px solid rgba(98, 216, 255, 0.10);
      border-radius: 50%;
    }

    .story::before {
      width: 760px;
      height: 180px;
      top: 90px;
      right: -340px;
      transform: rotate(-12deg);
    }

    .story::after {
      width: 520px;
      height: 120px;
      top: 160px;
      right: -230px;
      border-color: rgba(139, 125, 255, 0.09);
      transform: rotate(17deg);
    }

    .hero-space {
      position: relative;
      overflow: hidden;
      margin: 0 0 18px;
      padding: 23px 22px 21px;
      border: 1px solid rgba(98, 216, 255, 0.22);
      border-radius: 20px;
      background:
        radial-gradient(circle at 80% 15%, rgba(98,216,255,.12), transparent 28%),
        radial-gradient(circle at 15% 90%, rgba(139,125,255,.11), transparent 30%),
        linear-gradient(135deg, rgba(7,17,39,.90), rgba(3,8,19,.94));
      box-shadow: 0 18px 50px rgba(0,0,0,.48);
    }

    .hero-space::after {
      content: "";
      position: absolute;
      width: 250px;
      height: 250px;
      right: -88px;
      bottom: -140px;
      border-radius: 50%;
      background:
        radial-gradient(circle at 35% 30%,
          rgba(122, 212, 255, .34),
          rgba(27, 88, 154, .28) 32%,
          rgba(8, 30, 65, .20) 56%,
          transparent 68%);
      box-shadow:
        0 -10px 30px rgba(102, 204, 255, .16),
        inset 0 0 40px rgba(110, 195, 255, .10);
    }

    .hero-space .lead {
      margin-bottom: 0;
      max-width: 68ch;
    }

    .human-distance {
      margin: 14px 0 0;
      max-width: 70ch;
      color: #b9cee0;
      font-size: .95rem;
      position: relative;
      z-index: 1;
    }

    .human-distance strong {
      color: var(--data);
      font-weight: 700;
    }

    .story-kicker,
    .metric strong {
      color: var(--accent);
    }

    .note {
      border-left-color: var(--data);
      background: linear-gradient(90deg, rgba(120,255,179,.07), rgba(98,216,255,.05));
    }

    .step-btn.is-active {
      background: linear-gradient(90deg, var(--accent), #8ee7ff);
    }

    .section {
      backdrop-filter: blur(3px);
    }

    .section h2::before {
      content: "✦";
      color: rgba(98, 216, 255, .60);
      font-size: .72em;
      margin-right: .5em;
      vertical-align: .08em;
    }

    @media (max-width: 760px) {
      .chain,
      .metrics,
      .crosslinks {
        grid-template-columns: 1fr;
      }
      .chain div::after { content: ""; }
    }
  </style>
</head>

<body>
<main class="story" data-story-id="spazio-economia-europea-2026">

  <section class="hero-space">
    <p class="kicker">Dorsali Europee · Dorsale Spazio · realtà 2026</p>
    <h1>Lo spazio europeo e la sua economia</h1>

    <p class="lead">
      Una lettura GIS dell'ecosistema spaziale europeo: istituzioni, infrastrutture,
      centri operativi, mercato upstream e downstream e collegamenti con le altre
      infrastrutture strategiche del continente.
    </p>

    <p class="human-distance">
      Lo spazio sembra lontano. In realtà entra ogni giorno nelle nostre vite:
      <strong>nel telefono che ci localizza, nelle previsioni del tempo, nei trasporti,
      nell'agricoltura, nelle emergenze e nelle reti digitali</strong>.
      Questa mappa prova a rendere visibile ciò che normalmente resta sopra le nostre teste.
    </p>
  </section>

  <div class="note">
    Questo documentario descrive esclusivamente lo stato reale documentato al 2026.
    I pulsanti comandano i layer GIS già presenti nel progetto. I layer ancora in
    costruzione — industria —
    verrà collegata a questa pagina quando sarà importata.
  </div>

  <div class="chain" aria-label="Filiera dell'economia spaziale">
    <div>Ricerca e industria</div>
    <div>Infrastruttura spaziale</div>
    <div>Ground segment</div>
    <div>Servizi downstream</div>
  </div>

  <nav class="controls" aria-label="Comandi GIS Dorsale Spazio">
    <button type="button" class="step-btn" onclick="prepareSpace(this)">Prepara mappa</button>
    <button type="button" class="step-btn" onclick="showESA(this)">1 · Centri ESA</button>
    <button type="button" class="step-btn" onclick="showGalileo(this)">2 · Galileo / EUSPA</button>
    <button type="button" class="step-btn" onclick="showCopernicus(this)">3 · Copernicus / Terra</button>
    <button type="button" class="step-btn" onclick="showAccess(this)">4 · Accesso allo spazio</button>
    <button type="button" class="step-btn" onclick="showSafety(this)">5 · Sicurezza spaziale</button>
    <button type="button" class="step-btn" onclick="showSecureConnectivity(this)">6 · Connettività sicura</button>
    <button type="button" class="step-btn" onclick="showBoth(this)">7 · Rete spaziale europea</button>
    <button type="button" class="step-btn" onclick="restoreMap(this)">Ripristina mappa</button>
  </nav>

  <p class="current">
    Comando selezionato:
    <span class="current-command">nessuno</span>
  </p>

  <section class="section storybox" aria-live="polite">
    <p class="story-kicker" id="storyKicker">La dorsale come sistema</p>
    <h2 id="storyTitle">Lo spazio non è un punto sulla mappa</h2>
    <div class="story-body" id="storyBody">
      <p>
        Quando guardiamo il cielo, quasi nulla di questa infrastruttura è visibile.
        Eppure sopra l'Europa operano satelliti, segnali e sistemi che dipendono da una
        rete molto concreta di centri, antenne, sale di controllo, data centre e persone
        distribuite sul continente.
      </p>
      <p>
        I comandi sopra fanno emergere, un layer alla volta, questa geografia nascosta:
        la parte terrestre dello spazio europeo, quella che rende possibile ciò che in orbita
        appare remoto e quasi astratto.
      </p>
    </div>
    <div class="facts" id="storyFacts">
      <span class="chip">Stato: REAL_2026</span>
      <span class="chip">Story mode: layer GIS reali</span>
    </div>
  </section>

  <section class="section">
    <h2>1. Lo spazio europeo non è un solo sistema</h2>

    <h3>Unione europea</h3>
    <p>
      Il programma spaziale dell'UE comprende Galileo, EGNOS, Copernicus,
      GOVSATCOM, IRIS² e le attività legate alla sicurezza dell'ambiente spaziale.
      Il programma 2021–2027 dispone di un bilancio di circa
      <strong>14,88 miliardi di euro</strong>.
    </p>

    <h3>ESA</h3>
    <p>
      L'European Space Agency non è un'istituzione dell'Unione europea:
      è un'organizzazione intergovernativa con propri Stati membri e propri programmi.
      Il suo budget annuale nel 2025 era pari a circa
      <strong>7,68 miliardi di euro</strong>.
    </p>

    <h3>EUSPA</h3>
    <p>
      La European Union Agency for the Space Programme è invece un'agenzia dell'UE.
      Opera sul lato dei servizi, degli utenti, della sicurezza e dell'utilizzo
      economico delle infrastrutture spaziali europee.
    </p>

    <h3>EUMETSAT e agenzie nazionali</h3>
    <p>
      EUMETSAT gestisce sistemi meteorologici satellitari europei, mentre i singoli
      Stati mantengono programmi e agenzie nazionali. La geografia spaziale europea
      è quindi strutturalmente distribuita.
    </p>
  </section>

  <section class="section">
    <h2>2. Che cosa significa “economia dello spazio”</h2>
    <p>
      La space economy comprende le attività che producono valore attraverso
      l'esplorazione, lo studio, la gestione e l'utilizzo dello spazio.
      Una distinzione utile separa <strong>upstream</strong> e
      <strong>downstream</strong>.
    </p>

    <h3>Upstream</h3>
    <p>
      Ricerca e sviluppo, componentistica, satelliti, payload, piattaforme,
      stazioni terrestri professionali, lanciatori e servizi di lancio.
    </p>

    <h3>Downstream</h3>
    <p>
      Navigazione, telecomunicazioni, osservazione della Terra, meteorologia,
      agricoltura, trasporti, logistica, assicurazioni, energia, emergenze e
      servizi digitali che utilizzano dati o segnali satellitari.
    </p>

    <div class="metrics">
      <div class="metric">
        <strong>~€75 mld</strong>
        <span>mercato upstream mondiale 2025</span>
      </div>
      <div class="metric">
        <strong>~€490 mld</strong>
        <span>mercato downstream mondiale 2025</span>
      </div>
      <div class="metric">
        <strong>~€13,5 mld</strong>
        <span>budget spaziali pubblici europei 2025</span>
      </div>
    </div>
  </section>

  <section class="section">
    <h2>3. L'industria europea</h2>
    <p>
      Eurospace misura la parte manifatturiera dell'ecosistema: progettazione,
      sviluppo e produzione di sistemi spaziali. Nel 2024 riportava circa
      <strong>€8,835 miliardi di vendite finali</strong> e
      <strong>66.061 addetti diretti FTE</strong>.
    </p>
    <p>
      Nel 2025 le vendite finali dell'industria spaziale europea sono salite
      vicino agli <strong>€11 miliardi</strong>. Una quota molto rilevante del
      mercato upstream europeo continua a dipendere dalla domanda istituzionale.
    </p>
    <p>
      Parallelamente cresce un ecosistema di start-up, PMI e operatori New Space.
      Nel 2025 le imprese spaziali europee hanno raccolto circa
      <strong>€1,4 miliardi</strong> di investimenti privati.
    </p>
  </section>

  <section class="section">
    <h2>4. Il vero mercato è a Terra</h2>
    <p>
      Lo spazio produce valore economico quando i segnali e i dati diventano
      servizi terrestri. Il GNSS entra in telefoni, automobili, ferrovie, droni,
      logistica, emergenza e sincronizzazione. L'osservazione della Terra entra
      in agricoltura, clima, assicurazioni, pianificazione urbana e gestione
      delle catastrofi.
    </p>

    <div class="metrics">
      <div class="metric">
        <strong>€3,5 → 7,9 mld</strong>
        <span>Earth Observation globale, 2024 → 2034</span>
      </div>
      <div class="metric">
        <strong>€300 → 580 mld</strong>
        <span>GNSS globale, 2024 → 2034</span>
      </div>
      <div class="metric">
        <strong>&gt;€0,2 → ~1,2 mld</strong>
        <span>Secure SATCOM utenti UE, 2025 → 2040</span>
      </div>
    </div>
  </section>

  <section class="section">
    <h2>5. Galileo: una rete spaziale e terrestre</h2>
    <p>
      Galileo comprende un segmento spaziale, un segmento di terra e un segmento
      utente. La rete terrestre mappata comprende la sede EUSPA di Praga,
      i due Galileo Security Monitoring Centres, il GNSS Service Centre,
      il Galileo Reference Centre, i due Galileo Control Centres e stazioni
      remote nelle regioni artiche.
    </p>
    <p>
      Il layer GIS corrispondente è
      <code>spazio_galileo_euspa_2026</code>.
    </p>
  </section>

  <section class="section">
    <h2>6. ESA: la geografia della conoscenza spaziale</h2>
    <p>
      ESTEC, ESOC, ESRIN, EAC, ESAC, ESEC ed ECSAT svolgono funzioni differenti:
      ingegneria, operazioni, osservazione della Terra, astronauti, scienza,
      sicurezza, telecomunicazioni e innovazione.
    </p>
    <p>
      Il layer GIS corrispondente è
      <code>spazio_centri_esa_2026</code>.
    </p>
  </section>

  <section class="section">
    <h2>7. Copernicus: lo spazio diventa osservazione della Terra</h2>
    <p>
      Copernicus collega il segmento spaziale a una rete terrestre di centri,
      organizzazioni e servizi che trasformano le osservazioni satellitari in
      informazioni operative su atmosfera, clima, mare, territorio ed emergenze.
    </p>
    <p>
      Il layer GIS comprende EUMETSAT a Darmstadt, ECMWF a Bonn e Bologna,
      l'European Environment Agency a Copenaghen, Mercator Ocean a Tolosa
      e il Joint Research Centre di Ispra.
    </p>
    <p>
      Il layer GIS corrispondente è
      <code>spazio_copernicus_eumetsat_2026</code>.
    </p>
  </section>

  <section class="section">
    <h2>8. L'accesso allo spazio: dove l'Europa lascia la Terra</h2>
    <p>
      Prima che un satellite diventi un segnale, un'immagine o un servizio,
      deve esserci un luogo da cui partire. La geografia europea dell'accesso
      allo spazio è fatta di pochi nodi molto specializzati, collocati ai margini
      geografici del sistema.
    </p>
    <p>
      Il nodo principale è il <strong>Centre Spatial Guyanais di Kourou</strong>,
      nella Guyana francese: politicamente europeo, geograficamente sudamericano,
      vicino all'equatore e quindi particolarmente favorevole ai lanci orbitali.
      Da qui operano Ariane 6 e Vega-C.
    </p>
    <p>
      Più a nord, <strong>Andøya</strong> in Norvegia, <strong>Esrange</strong>
      in Svezia e <strong>SaxaVord</strong> nelle Shetland rappresentano la nuova
      geografia dei lanciatori leggeri, delle orbite polari, dei test e del New Space europeo.
    </p>
    <p>
      Il layer GIS corrispondente è
      <code>spazio_accesso_spazio_2026</code>.
    </p>
  </section>

  <section class="section">
    <h2>9. Lo spazio va sorvegliato</h2>
    <p>
      Una volta raggiunta l'orbita, il problema non è soltanto far funzionare
      un satellite. Bisogna sapere <strong>che cosa gli passa vicino</strong>,
      prevedere possibili collisioni, seguire i detriti, osservare i rientri
      nell'atmosfera e capire quando il Sole può disturbare comunicazioni,
      navigazione e reti tecnologiche a Terra.
    </p>
    <p>
      La sicurezza spaziale europea è quindi una rete di osservazione e calcolo.
      Il <strong>EU SST Front Desk</strong> distribuisce servizi di sorveglianza
      e tracciamento; lo <strong>Space Debris Office</strong> dell'ESA a Darmstadt
      studia l'ambiente dei detriti; il <strong>NEO Coordination Centre</strong>
      di Frascati segue asteroidi e comete vicini alla Terra.
    </p>
    <p>
      A Bruxelles viene coordinata la rete europea per lo
      <strong>space weather</strong>, mentre a Tenerife telescopi e sistemi laser
      osservano oggetti artificiali e naturali nel cielo. È una parte dello spazio
      che raramente vediamo: una sorveglianza continua che rende possibile usare
      l'orbita come infrastruttura.
    </p>
    <div class="facts">
      <span class="chip">SST · oggetti e collisioni</span>
      <span class="chip">SWE · meteo spaziale</span>
      <span class="chip">NEO · asteroidi e comete</span>
    </div>
    <p>
      Il layer GIS corrispondente è
      <code>spazio_sicurezza_spaziale_2026</code>.
    </p>
  </section>

  <section class="section">
    <h2>10. Quando lo spazio diventa rete</h2>
    <p>
      C'è un punto in cui la Dorsale Spazio smette quasi di sembrare “spaziale”.
      I satelliti diventano <strong>infrastruttura di comunicazione</strong>:
      collegano istituzioni, servizi pubblici e reti critiche quando i collegamenti
      terrestri non bastano o non sono disponibili.
    </p>
    <p>
      Nel 2026 <strong>EU GOVSATCOM</strong> è già entrato nella fase operativa iniziale.
      Il sistema non nasce da una nuova costellazione unica: mette in comune capacità
      satellitari sicure già disponibili e le distribuisce agli utenti governativi
      attraverso un'infrastruttura europea comune.
    </p>
    <p>
      <strong>IRIS²</strong> rappresenta il passo successivo. Nel 2026 è in fase di
      implementazione: non è ancora una costellazione operativa, ma è il progetto con cui
      l'Unione europea punta a costruire una propria infrastruttura multi-orbitale di
      connettività sicura. I primi lanci sono previsti dal 2029.
    </p>
    <p>
      Nella geografia terrestre di questa rete compaiono la sede EUSPA di Praga,
      la Commissione europea a Bruxelles e i futuri hub permanenti GOVSATCOM di
      <strong>Colonia</strong> e <strong>Agios Ioannis</strong> in Grecia.
      È qui che lo spazio comincia a sovrapporsi alla Dorsale Digitale.
    </p>
    <div class="facts">
      <span class="chip">GOVSATCOM · operativo iniziale 2026</span>
      <span class="chip">IRIS² · implementazione</span>
      <span class="chip">Primi lanci IRIS² · dal 2029</span>
    </div>
    <p>
      Il layer GIS corrispondente è
      <code>spazio_connettivita_sicura_2026</code>.
    </p>
  </section>

  <section class="section">
    <h2>11. Le connessioni con le altre dorsali</h2>

    <div class="crosslinks">
      <div><strong>Spazio ↔ Trasporti</strong><br>Galileo, EGNOS, aviazione, droni, logistica.</div>
      <div><strong>Spazio ↔ Ambiente</strong><br>Copernicus, clima, oceani, territorio.</div>
      <div><strong>Spazio ↔ Digitale</strong><br>IRIS², GOVSATCOM, cloud, AI, ground segment.</div>
      <div><strong>Spazio ↔ Energia</strong><br>monitoraggio, sincronizzazione, resilienza.</div>
      <div><strong>Spazio ↔ Sicurezza</strong><br>SSA, comunicazioni protette, infrastrutture critiche.</div>
      <div><strong>Spazio ↔ Ricerca</strong><br>astronomia, fisica, osservazione, tecnologia.</div>
    </div>
  </section>

  <section class="section future">
    <h2>12. Layer GIS successivi</h2>
    <p>
      Questi temi fanno già parte del documentario ma non vengono ancora comandati
      dalla pagina finché i relativi layer non saranno costruiti e importati:
    </p>
    <ul>
      <li><code>07_INDUSTRIA_SPAZIALE</code></li>
    </ul>
  </section>

  <section class="section">
    <h2>Fonti principali</h2>
    <ul class="sources">
      <li><a href="https://www.esa.int/About_Us/Business_with_ESA/ESA_releases_2026_Space_Economy_Report" target="_blank" rel="noopener">ESA Space Economy Report 2026</a></li>
      <li><a href="https://www.esa.int/About_Us/Corporate_news/ESA_facts" target="_blank" rel="noopener">ESA facts</a></li>
      <li><a href="https://www.euspa.europa.eu/eu-space-programme" target="_blank" rel="noopener">EU Space Programme / EUSPA</a></li>
      <li><a href="https://www.euspa.europa.eu/market-report" target="_blank" rel="noopener">EU Space Market Report 2026</a></li>
      <li><a href="https://eurospace.org/publication/eurospace-facts-figures/" target="_blank" rel="noopener">Eurospace Facts &amp; Figures</a></li>
      <li><a href="https://www.eumetsat.int/about-us/who-we-are" target="_blank" rel="noopener">EUMETSAT</a></li>
    </ul>
  </section>

  <p class="foot">
    GIS API:
    <code>GIS.showLayer()</code>,
    <code>GIS.showOnlyLayer()</code>,
    <code>GIS.hideLayer()</code>,
    <code>GIS.hideAllLayersExcept()</code>,
    <code>GIS.saveState()</code>,
    <code>GIS.restoreState()</code>.
  </p>

</main>

<script>
(function () {
  "use strict";

  var BASE_LAYERS = [
    "ne_10m_admin_0_countries",
    "cnoteurope"
  ];

  var SPACE_LAYERS = {
    esa: "spazio_centri_esa_2026",
    galileo: "spazio_galileo_euspa_2026",
    copernicus: "spazio_copernicus_eumetsat_2026",
    access: "spazio_accesso_spazio_2026",
    safety: "spazio_sicurezza_spaziale_2026",
    secureConnectivity: "spazio_connettivita_sicura_2026"
  };

  function getGIS() {
    if (window.GIS) return window.GIS;
    if (window.parent && window.parent.GIS) return window.parent.GIS;
    return null;
  }

  function setActive(button) {
    document.querySelectorAll(".step-btn.is-active").forEach(function (el) {
      el.classList.remove("is-active");
    });

    if (button) button.classList.add("is-active");

    var label = document.querySelector(".current-command");
    if (label && button) {
      label.textContent = button.textContent.trim();
    }
  }

  function gotoMap(GIS, lat, lon, zoom) {

    if (typeof GIS.goto === "function") {
      GIS.goto(lat, lon, zoom);
      return;
    }

    if (typeof GIS.gotoGIS === "function") {
      GIS.gotoGIS(lat, lon, zoom);
      return;
    }

    if (window.parent &&
        typeof window.parent.gotoGIS === "function") {

      window.parent.gotoGIS(lat, lon, zoom);
      return;
    }

    if (window.parent &&
        typeof window.parent.applyAtlasCommand === "function") {

      window.parent.applyAtlasCommand({
        goto: {
          lat: lat,
          lon: lon,
          zoom: zoom
        }
      });
    }
  }

  function showOnlySpaceLayer(GIS, target) {

    if (typeof GIS.hideAllLayersExcept === "function") {
      GIS.hideAllLayersExcept(
        BASE_LAYERS.concat([target])
      );
      return;
    }

    if (typeof GIS.showLayer === "function") {
      GIS.showLayer(target);
    }
  }


  function hideAllSpaceLayers(GIS) {

    if (typeof GIS.hideLayer === "function") {
      GIS.hideLayer(SPACE_LAYERS.esa);
      GIS.hideLayer(SPACE_LAYERS.galileo);
      GIS.hideLayer(SPACE_LAYERS.copernicus);
      GIS.hideLayer(SPACE_LAYERS.access);
      GIS.hideLayer(SPACE_LAYERS.safety);
      GIS.hideLayer(SPACE_LAYERS.secureConnectivity);
      return;
    }

    if (typeof GIS.hideAllLayersExcept === "function") {
      GIS.hideAllLayersExcept(BASE_LAYERS);
    }
  }


  /* ============================================
   * PREPARA MAPPA
   * ============================================ */

  window.prepareSpace = function (button) {

    var GIS = getGIS();

    setActive(button);

    if (!GIS) {
      alert("GIS non disponibile");
      return;
    }

    hideAllSpaceLayers(GIS);

    if (typeof GIS.hideAllLayersExcept === "function") {
      GIS.hideAllLayersExcept(BASE_LAYERS);
    }

    gotoMap(GIS, 51.0, 10.0, 4);
  };


  /* ============================================
   * CENTRI ESA
   * ============================================ */

  window.showESA = function (button) {

    var GIS = getGIS();

    setActive(button);

    if (!GIS) {
      alert("GIS non disponibile");
      return;
    }

    hideAllSpaceLayers(GIS);

    if (typeof GIS.hideAllLayersExcept === "function") {
      GIS.hideAllLayersExcept(BASE_LAYERS);
    }

    if (typeof GIS.showLayer === "function") {
      GIS.showLayer(SPACE_LAYERS.esa);
    }

    gotoMap(GIS, 50.0, 8.0, 4);
  };


  /* ============================================
   * GALILEO / EUSPA
   * ============================================ */

  window.showGalileo = function (button) {

    var GIS = getGIS();

    setActive(button);

    if (!GIS) {
      alert("GIS non disponibile");
      return;
    }

    hideAllSpaceLayers(GIS);

    if (typeof GIS.hideAllLayersExcept === "function") {
      GIS.hideAllLayersExcept(BASE_LAYERS);
    }

    if (typeof GIS.showLayer === "function") {
      GIS.showLayer(SPACE_LAYERS.galileo);
    }

    gotoMap(GIS, 58.0, 8.0, 3);
  };


  /* ============================================
   * COPERNICUS / EUMETSAT
   * ============================================ */

  window.showCopernicus = function (button) {

    var GIS = getGIS();

    setActive(button);

    if (!GIS) {
      alert("GIS non disponibile");
      return;
    }

    hideAllSpaceLayers(GIS);

    if (typeof GIS.hideAllLayersExcept === "function") {
      GIS.hideAllLayersExcept(BASE_LAYERS);
    }

    if (typeof GIS.showLayer === "function") {
      GIS.showLayer(SPACE_LAYERS.copernicus);
    }

    gotoMap(GIS, 50.5, 8.0, 4);
  };


  /* ============================================
   * ACCESSO ALLO SPAZIO
   * ============================================ */

  window.showAccess = function (button) {

    var GIS = getGIS();

    setActive(button);

    if (!GIS) {
      alert("GIS non disponibile");
      return;
    }

    hideAllSpaceLayers(GIS);

    if (typeof GIS.hideAllLayersExcept === "function") {
      GIS.hideAllLayersExcept(BASE_LAYERS);
    }

    if (typeof GIS.showLayer === "function") {
      GIS.showLayer(SPACE_LAYERS.access);
    }

    gotoMap(GIS, 42.0, -8.0, 2);
  };


  /* ============================================
   * SICUREZZA SPAZIALE
   * ============================================ */

  window.showSafety = function (button) {

    var GIS = getGIS();

    setActive(button);

    if (!GIS) {
      alert("GIS non disponibile");
      return;
    }

    hideAllSpaceLayers(GIS);

    if (typeof GIS.hideAllLayersExcept === "function") {
      GIS.hideAllLayersExcept(BASE_LAYERS);
    }

    if (typeof GIS.showLayer === "function") {
      GIS.showLayer(SPACE_LAYERS.safety);
    }

    gotoMap(GIS, 47.0, 4.0, 4);
  };


  /* ============================================
   * CONNETTIVITA SICURA
   * ============================================ */

  window.showSecureConnectivity = function (button) {

    var GIS = getGIS();

    setActive(button);

    if (!GIS) {
      alert("GIS non disponibile");
      return;
    }

    hideAllSpaceLayers(GIS);

    if (typeof GIS.hideAllLayersExcept === "function") {
      GIS.hideAllLayersExcept(BASE_LAYERS);
    }

    if (typeof GIS.showLayer === "function") {
      GIS.showLayer(SPACE_LAYERS.secureConnectivity);
    }

    gotoMap(GIS, 50.0, 10.0, 4);
  };


  /* ============================================
   * RETE SPAZIALE EUROPEA
   * ============================================ */

 window.showBoth = function (button) {

    var GIS = getGIS();

    setActive(button);

    if (!GIS) {
      alert("GIS non disponibile");
      return;
    }

    hideAllSpaceLayers(GIS);

    if (typeof GIS.hideAllLayersExcept === "function") {
      GIS.hideAllLayersExcept(BASE_LAYERS);
    }

    if (typeof GIS.showLayer === "function") {
      GIS.showLayer(SPACE_LAYERS.esa);
      GIS.showLayer(SPACE_LAYERS.galileo);
      GIS.showLayer(SPACE_LAYERS.copernicus);
      GIS.showLayer(SPACE_LAYERS.access);
      GIS.showLayer(SPACE_LAYERS.safety);
      GIS.showLayer(SPACE_LAYERS.secureConnectivity);
    }

    gotoMap(GIS, 42.0, -8.0, 2);
  };


  /* ============================================
   * RIPRISTINO MINIMO
   * ============================================ */

  window.restoreMap = function (button) {

    var GIS = getGIS();

    setActive(button);

    if (!GIS) {
      alert("GIS non disponibile");
      return;
    }

    hideAllSpaceLayers(GIS);

    if (typeof GIS.hideAllLayersExcept === "function") {
      GIS.hideAllLayersExcept(BASE_LAYERS);
    }

    gotoMap(GIS, 51.0, 10.0, 4);
  };

})();
</script>

</body>
</html>
